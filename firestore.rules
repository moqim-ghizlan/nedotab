rules_version = '2';
// Every allowed path is written explicitly: no recursive wildcard on users/{uid}, because
// permissions add up and one would also open users/{uid}/prive/** (V4, functions only).
// Deep validation of the grid (types, depth <= 3) is done by the app on every read
// (valider()); these rules guarantee ownership and the general shape.
service cloud.firestore {
  match /databases/{db}/documents {

    // V4.23: a signed-in user whose e-mail is not verified has NO access to anything. Google
    // accounts always carry email_verified = true; an e-mail account gets it by clicking the
    // link of the verification e-mail (the token is refreshed afterwards).
    function connecte() { return request.auth != null && request.auth.token.email_verified == true; }
    function proprietaire(uid) { return connecte() && request.auth.uid == uid; }

    function grilleValide(d) {
      return d.keys().hasOnly(['versionSchema', 'grille', 'reglages', 'majLe', 'majPar', 'revision'])
        && d.versionSchema is int && d.versionSchema >= 1 && d.versionSchema <= 10
        && d.grille is list && d.grille.size() <= 1000
        && d.reglages is map
        && d.majLe == request.time
        && d.majPar is string && d.majPar.size() <= 64
        && (!('revision' in d) || d.revision is int);
    }

    match /users/{uid} {
      allow read: if proprietaire(uid);
      allow create: if proprietaire(uid) && grilleValide(request.resource.data);
      // V2.9: every write is above the revision it was computed from (transaction).
      allow update: if proprietaire(uid) && grilleValide(request.resource.data)
        && (!('revision' in resource.data)
            || (request.resource.data.revision is int
                && request.resource.data.revision > resource.data.revision));
      allow delete: if proprietaire(uid);
    }

    match /users/{uid}/sauvegardes/{id} {
      allow read, delete: if proprietaire(uid);
      allow create: if proprietaire(uid)
        && request.resource.data.keys().hasOnly(['creeLe', 'type', 'nom', 'appareil', 'versionSchema', 'nbSites', 'nbDossiers', 'grille', 'reglages'])
        && request.resource.data.type in ['auto', 'manuelle', 'avant-restauration']
        && request.resource.data.creeLe == request.time
        && (request.resource.data.nom == null
            || (request.resource.data.nom is string
                && request.resource.data.nom.size() >= 1
                && request.resource.data.nom.size() <= 60))
        && request.resource.data.appareil in ['extension', 'pwa', 'iphone', 'ipad', 'navigateur']
        && request.resource.data.nbSites is int
        && request.resource.data.nbDossiers is int
        && request.resource.data.grille is list
        && request.resource.data.reglages is map;
      allow update: if false; // a backup is never modified
    }

    // V4.15: conversations of the chat. The browser creates the conversation and its own
    // messages and renames; the answers of the assistant and the counters are written by the
    // functions (Admin SDK, rules do not apply to them).
    match /users/{uid}/conversations/{convId} {
      allow read, delete: if proprietaire(uid);
      allow create: if proprietaire(uid)
        && request.resource.data.keys().hasOnly(['titre', 'creeLe', 'majLe', 'nbMessages', 'modele', 'apercu'])
        && request.resource.data.titre is string
        && request.resource.data.titre.size() >= 1
        && request.resource.data.titre.size() <= 80
        && request.resource.data.creeLe == request.time
        && request.resource.data.majLe == request.time
        && request.resource.data.nbMessages == 0
        && request.resource.data.modele is string
        && request.resource.data.modele.size() <= 80
        && request.resource.data.apercu is string
        && request.resource.data.apercu.size() <= 100;
      // Renaming only: the counters belong to the functions.
      allow update: if proprietaire(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['titre'])
        && request.resource.data.titre is string
        && request.resource.data.titre.size() >= 1
        && request.resource.data.titre.size() <= 80;

      match /messages/{msgId} {
        allow read, delete: if proprietaire(uid);
        // Only the user's own messages; a message of the assistant is written by the server.
        allow create: if proprietaire(uid)
          && exists(/databases/$(db)/documents/users/$(uid)/conversations/$(convId))
          && request.resource.data.keys().hasOnly(['role', 'texte', 'creeLe', 'etat', 'origine'])
          && request.resource.data.role == 'user'
          && request.resource.data.texte is string
          && request.resource.data.texte.size() >= 1
          && request.resource.data.texte.size() <= 4000
          && request.resource.data.creeLe == request.time
          && request.resource.data.etat == 'ok'
          && (!('origine' in request.resource.data) || request.resource.data.origine in ['barre', 'chat']);
        // Never modified, except (V4.16) the status of the proposal of an answer: once, from
        // "en_attente" to "appliquee", "ignoree" or "partielle".
        allow update: if proprietaire(uid)
          && resource.data.role == 'assistant'
          && 'proposition' in resource.data
          && resource.data.statutProposition == 'en_attente'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statutProposition'])
          && request.resource.data.statutProposition in ['appliquee', 'ignoree', 'partielle'];
      }
    }

    // V4.19: statistics of use (counters only), written by the functions; the user reads them.
    // The cache of the answers lives under prive/ and stays closed to the browser.
    match /users/{uid}/usage/{mois} {
      allow read: if proprietaire(uid);
      allow write: if false;
    }

    // V4.21: usage statistics of the sites (weights, counts, last visits). Explicit path, no
    // wildcard. The values themselves are validated by the app on every read.
    match /users/{uid}/stats/visites {
      allow read, delete: if proprietaire(uid);
      allow create, update: if proprietaire(uid)
        && request.resource.data.keys().hasOnly(['poids', 'compte', 'derniere', 'majLe'])
        && request.resource.data.poids is map && request.resource.data.poids.size() <= 3000
        && request.resource.data.compte is map && request.resource.data.compte.size() <= 3000
        && request.resource.data.derniere is map && request.resource.data.derniere.size() <= 3000
        && request.resource.data.majLe == request.time;
    }

    // V4.24: sharing space (texts and links). The rules cannot count a collection: the counter
    // espacePartageMeta/usage is changed in the same batch as each element (getAfter), so a 201st
    // element, or an add that does not increment the counter by exactly 1, is refused.
    match /users/{uid}/espacePartage/{id} {
      allow read, delete: if proprietaire(uid);
      allow create: if proprietaire(uid)
        && request.resource.data.keys().hasOnly(['type', 'contenu', 'titre', 'creeLe', 'appareil', 'epingle', 'taille', 'typeMime', 'chemin', 'chiffre'])
        && chiffreValide(request.resource.data)
        && request.resource.data.type in ['texte', 'lien', 'fichier']
        && (request.resource.data.type == 'fichier'
            ? fichierValide(uid, request.resource.data)
            : !request.resource.data.keys().hasAny(['taille', 'typeMime', 'chemin']))
        && request.resource.data.contenu is string
        && request.resource.data.contenu.size() >= 1
        && request.resource.data.contenu.size() <= (request.resource.data.get('chiffre', false) ? 110000 : 20000)
        && request.resource.data.titre is string
        && request.resource.data.titre.size() <= 200
        && request.resource.data.creeLe == request.time
        && request.resource.data.appareil is string
        && request.resource.data.appareil.size() <= 64
        && request.resource.data.epingle is bool
        && getAfter(/databases/$(db)/documents/users/$(uid)/espacePartageMeta/usage).data.nb <= 200
        && getAfter(/databases/$(db)/documents/users/$(uid)/espacePartageMeta/usage).data.nb
          == (exists(/databases/$(db)/documents/users/$(uid)/espacePartageMeta/usage)
              ? get(/databases/$(db)/documents/users/$(uid)/espacePartageMeta/usage).data.nb : 0) + 1;
      // Pin / unpin, or bring an element back to the top (same content sent again).
      allow update: if proprietaire(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['epingle', 'creeLe'])
        && request.resource.data.epingle is bool
        && (request.resource.data.creeLe == resource.data.creeLe
            || request.resource.data.creeLe == request.time);
    }

    // V4.26: an encrypted item holds "v<n>.<iv>.<data>" (base64url) in `contenu` and nothing in
    // `titre` (the title is inside the encrypted block). The server only checks the SHAPE.
    function chiffreValide(d) {
      return !('chiffre' in d) || d.chiffre == false
        || (d.chiffre == true
            && d.contenu is string
            && d.contenu.matches('^v[0-9]+[.][A-Za-z0-9_-]{16}[.][A-Za-z0-9_-]+$')
            && d.titre == '');
    }

    // V4.26: description of the vault (salts + wrapped keys, already encrypted on the device).
    // Created only if absent (a rule "create" never matches an existing document); an update may
    // change the wrapping fields only (new password / new secret key).
    function metaCoffreValide(d) {
      return d.keys().hasOnly(['version', 'sel1', 'sel2', 'iterations', 'enveloppeMdp', 'enveloppeSecours', 'creeLe', 'majLe'])
        && d.version == 1
        && d.iterations is int && d.iterations >= 310000 && d.iterations <= 2000000
        && d.sel1 is string && d.sel1.size() >= 16 && d.sel1.size() <= 64
        && d.sel2 is string && d.sel2.size() >= 16 && d.sel2.size() <= 64
        && d.enveloppeMdp is string && d.enveloppeMdp.size() <= 200
        && d.enveloppeMdp.matches('^v[0-9]+[.][A-Za-z0-9_-]{16}[.][A-Za-z0-9_-]+$')
        && d.enveloppeSecours is string && d.enveloppeSecours.size() <= 200
        && d.enveloppeSecours.matches('^v[0-9]+[.][A-Za-z0-9_-]{16}[.][A-Za-z0-9_-]+$');
    }

    match /users/{uid}/vaultMeta/cle {
      allow read, delete: if proprietaire(uid);
      allow create: if proprietaire(uid) && metaCoffreValide(request.resource.data)
        && request.resource.data.creeLe == request.time
        && !('majLe' in request.resource.data);
      allow update: if proprietaire(uid) && metaCoffreValide(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sel1', 'sel2', 'enveloppeMdp', 'enveloppeSecours', 'majLe'])
        && request.resource.data.majLe == request.time;
    }

    // V4.25: a file element points to partages/{uid}/{id}/{name} in Storage (never a URL) and
    // carries its size; the counter "octets" goes up by exactly that size in the same batch.
    function fichierValide(uid, d) {
      return d.taille is int && d.taille > 0 && d.taille <= 26214400
        && d.typeMime is string && d.typeMime.size() <= 100
        && d.chemin is string && d.chemin.matches('partages/' + uid + '/[^/]+/[^/]+')
        && getAfter(/databases/$(db)/documents/users/$(uid)/espacePartageMeta/usage).data.get('octets', 0) <= 209715200
        && getAfter(/databases/$(db)/documents/users/$(uid)/espacePartageMeta/usage).data.get('octets', 0)
          == (exists(/databases/$(db)/documents/users/$(uid)/espacePartageMeta/usage)
              ? get(/databases/$(db)/documents/users/$(uid)/espacePartageMeta/usage).data.get('octets', 0) : 0) + d.taille;
    }

    match /users/{uid}/espacePartageMeta/usage {
      allow read, delete: if proprietaire(uid);
      allow create, update: if proprietaire(uid)
        && request.resource.data.keys().hasOnly(['nb', 'octets'])
        && request.resource.data.nb is int
        && request.resource.data.nb >= 0
        && request.resource.data.nb <= 200
        && (!('octets' in request.resource.data)
            || (request.resource.data.octets is int
                && request.resource.data.octets >= 0
                && request.resource.data.octets <= 209715200));
    }

    match /config/{doc} {
      allow read: if connecte();
      allow write: if false;
    }

    // Everything else (including users/{uid}/prive/**) is denied by default.
  }
}
