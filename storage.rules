rules_version = '2';
// Backgrounds only, in the owner's folder, 5 MB max, raster images only.
// The number of backgrounds (10 max) is enforced by the app: rules cannot count files.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/fonds/{fichier} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg|png)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
