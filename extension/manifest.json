{
  "manifest_version": 3,
  "name": "NedoTab",
  "version": "0.0.0",
  "description": "Page Nouvel onglet avec grille d'icônes et dossiers.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "favicon"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": ""
}
