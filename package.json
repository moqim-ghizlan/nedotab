{
  "name": "nedotab",
  "version": "2.7.0",
  "private": true,
  "type": "module",
  "description": "Page Nouvel onglet avec grille d'icônes et dossiers imbriqués.",
  "scripts": {
    "dev:extension": "vite build --mode extension --watch",
    "build:extension": "vite build --mode extension",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icones": "node scripts/generer-icones.js",
    "verifier": "node scripts/verifier-code-distant.js dist/extension",
    "package": "npm run build:extension && npm run verifier && node scripts/empaqueter.js",
    "verifier:navigateur": "node scripts/verifier-navigateur.mjs",
    "tester-sites": "node scripts/tester-sites.mjs",
    "test:couverture": "vitest run --coverage",
    "captures": "node scripts/captures-site.mjs",
    "build:site": "vite build --config vite.site.config.js",
    "publier": "node scripts/publier.js",
    "verifier:site": "node scripts/verifier-site.mjs",
    "emulateurs": "firebase emulators:start --import=./.emulateurs --export-on-exit",
    "deployer:regles": "firebase deploy --only firestore:rules,storage",
    "test:regles": "firebase emulators:exec --only auth,firestore,storage \"vitest run --project regles\"",
    "verifier:compte": "firebase emulators:exec --only auth,firestore,storage \"node scripts/verifier-navigateur.mjs --seulement=compte\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "firebase-tools": "^15.34.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "sortablejs": "^1.15.7"
  }
}
