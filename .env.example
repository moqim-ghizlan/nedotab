# Firebase web configuration (Console Firebase → Paramètres du projet → Vos applications).
# Not secret (it ends up in the browser), kept out of the repository to switch projects.
# Copy to .env.local and fill in. With VITE_UTILISER_EMULATEURS=true and no values, the
# local "demo-nedotab" project of the emulators is used.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_UTILISER_EMULATEURS=false

# Web app only (V3.2): sign-in domain = the Hosting domain of the app, never firebaseapp.com
# (Safari blocks the redirect otherwise). Empty: <project id>.web.app.
VITE_FIREBASE_AUTH_DOMAIN_PWA=

# Google sign-in in the extension: OAuth client of type "Chrome extension" (Google Cloud),
# created for the extension id imegmpimokhlnlhcmaogimnlgcfgefnn.
VITE_OAUTH_CLIENT_ID_EXTENSION=

# Google sign-in in other Chromium browsers (Brave, Edge, Opera): OAuth client of type
# "Web application" with the redirect URI https://imegmpimokhlnlhcmaogimnlgcfgefnn.chromiumapp.org/
VITE_OAUTH_CLIENT_ID_WEB=

# App Check for the PWA (reCAPTCHA Enterprise site key, V3). Not used by the extension.
VITE_APPCHECK_CLE_RECAPTCHA=
